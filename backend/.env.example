GOOGLE_API_KEY=your_google_api_key_here
# Optional alias (either GOOGLE_API_KEY or GEMINI_API_KEY works)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=20
GEMINI_MAX_RETRIES=2
GEMINI_RETRY_BACKOFF_SECONDS=1.0

# HashiCorp Vault (optional, recommended for production secret management)
VAULT_ENABLED=false
VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=
VAULT_NAMESPACE=
VAULT_MOUNT=secret
VAULT_SECRET_PATH=sentinelai/llm
VAULT_GEMINI_KEY_FIELD=google_api_key
VAULT_REFRESH_INTERVAL_SECONDS=60
VAULT_TIMEOUT_SECONDS=5
