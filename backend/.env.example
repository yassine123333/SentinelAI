# ── App ────────────────────────────────────────────────────────────────────────
DEBUG=false
FRONTEND_URL=http://localhost:5173

# ── MongoDB ────────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=sentinelai

# ── JWT ────────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY=change-me-to-a-long-random-secret-before-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Email — Brevo ──────────────────────────────────────────────────────────────
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=your-sender@email.com
BREVO_SENDER_NAME=SentinelAI

# ── AI — Groq API ──────────────────────────────────────────────────────────────
# Key rotation pool: comma-separated list of gsk_… keys.
# The client rotates automatically on 429 / rate-limit errors.
GROQ_API_KEY=your-groq-key-1
GROQ_API_KEY_2=your-groq-key-2
GROQ_API_KEY_3=your-groq-key-3
GROQ_MODEL=llama-3.1-8b-instant

# ── Agent 02 — Neo4j Knowledge Graph ─────────────────────────────────────────
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me

# ── Agent 02 — Weaviate Vector DB ─────────────────────────────────────────────
WEAVIATE_URL=https://your-cluster.weaviate.cloud
WEAVIATE_KEY=your-weaviate-key

# ── Agent 02 — Models ─────────────────────────────────────────────────────────
REASONING_MODEL=llama-3.1-8b-instant
ROUTING_MODEL=llama-3.1-8b-instant
EMBEDDING_MODEL=
EMBEDDING_DIM=3072

# ── Agent 02 — Data sources & schedule ───────────────────────────────────────
GDELT_API_URL=https://api.gdeltproject.org/api/v2
PATTERN_SCAN_INTERVAL_HOURS=1
INGESTION_INTERVAL_MINUTES=15

# ── Cookie security ────────────────────────────────────────────────────────────
# false in local dev (HTTP), true in production (HTTPS)
COOKIE_SECURE=false

# ── reCAPTCHA v3 ───────────────────────────────────────────────────────────────
RECAPTCHA_SECRET_KEY=your-recaptcha-secret

# ── Cloudflare Turnstile ───────────────────────────────────────────────────────
TURNSTILE_SECRET_KEY=your-turnstile-secret

# ── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (no wildcards in production)
CORS_ORIGINS=http://localhost:5173

# ── HashiCorp Vault (optional, recommended for production secret management) ─
VAULT_ENABLED=false
VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=
VAULT_NAMESPACE=
VAULT_MOUNT=secret
VAULT_SECRET_PATH=sentinelai/llm
VAULT_GEMINI_KEY_FIELD=google_api_key
VAULT_REFRESH_INTERVAL_SECONDS=60
VAULT_TIMEOUT_SECONDS=5
