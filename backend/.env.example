# ── App ────────────────────────────────────────────────────────────────────────
DEBUG=false
FRONTEND_URL=http://localhost:5173

# ── MongoDB Atlas ──────────────────────────────────────────────────────────────
# Get connection string from Atlas → Connect → Drivers → Python 3.12+
# Include the database name in the URI and always set retryWrites + w=majority
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/sentinelai?retryWrites=true&w=majority&appName=SentinelAI
MONGODB_DB=sentinelai

# ── JWT ────────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY=change-me-to-a-long-random-secret-before-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Email — Brevo ──────────────────────────────────────────────────────────────
BREVO_API_KEY=xkeysib-...
BREVO_SENDER_EMAIL=you@example.com
BREVO_SENDER_NAME=SentinelAI

# ── AI — Groq API ──────────────────────────────────────────────────────────────
# Key rotation pool: the client round-robins across all supplied keys
# and backs off automatically on 429s. Add more as GROQ_API_KEY_2, _3, …
GROQ_API_KEY=gsk_...
GROQ_API_KEY_2=gsk_...
GROQ_API_KEY_3=gsk_...
GROQ_MODEL=llama-3.1-8b-instant

# ── Agent 02 — Neo4j Knowledge Graph ───────────────────────────────────────────
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ── Agent 02 — Weaviate Vector DB ──────────────────────────────────────────────
WEAVIATE_URL=https://<cluster>.weaviate.cloud
WEAVIATE_KEY=

# ── Agent 02 — Models & schedule ───────────────────────────────────────────────
REASONING_MODEL=llama-3.1-8b-instant
ROUTING_MODEL=llama-3.1-8b-instant
EMBEDDING_MODEL=
EMBEDDING_DIM=3072
GDELT_API_URL=https://api.gdeltproject.org/api/v2
PATTERN_SCAN_INTERVAL_HOURS=1
INGESTION_INTERVAL_MINUTES=15

# ── Cookie security ────────────────────────────────────────────────────────────
# false in local dev (HTTP), true in production (HTTPS)
COOKIE_SECURE=false

# ── reCAPTCHA v3 ───────────────────────────────────────────────────────────────
RECAPTCHA_SECRET_KEY=

# ── Cloudflare Turnstile ────────────────────────────────────────────────────────
TURNSTILE_SECRET_KEY=

# ── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (no wildcards in production)
CORS_ORIGINS=http://localhost:5173
