# ── Local LLM — Ollama ────────────────────────────────────────────────────────
# Ollama must be running locally: https://ollama.com
# Pull the model first: ollama pull llama3.1:8b-instruct-q4_K_M
OLLAMA_MODEL=llama3.1:8b-instruct-q4_K_M
OLLAMA_BASE_URL=http://localhost:11434

# HashiCorp Vault (optional, recommended for production secret management)
VAULT_ENABLED=false
VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=
VAULT_NAMESPACE=
VAULT_MOUNT=secret
VAULT_SECRET_PATH=sentinelai/llm
VAULT_REFRESH_INTERVAL_SECONDS=60
VAULT_TIMEOUT_SECONDS=5
