# ── Docker Compose ports ────────────────────────────────────────────────────────
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=5173

# ── Neo4j Knowledge Graph ───────────────────────────────────────────────────────
# Used by docker-compose to set NEO4J_AUTH on the neo4j container
# Must match NEO4J_PASSWORD in backend/.env
NEO4J_PASSWORD=<generate: python -c "import secrets; print(secrets.token_hex(24))"&gt;

# ── Caddy (production profile only) ────────────────────────────────────────────
DOMAIN=yourdomain.com
ACME_EMAIL=admin@yourdomain.com

# ── SOC Security Daemon ─────────────────────────────────────────────────────────
# Blocking layers (set true only when Nginx/Azure NSG are reachable)
BLOCK_LAYER_NGINX=false
BLOCK_LAYER_AZURE=false
BLOCK_DRY_RUN=false

# Daemon tuning
SOC_POLL_INTERVAL=10
SOC_RATE_THRESHOLD=30
SOC_AUTH_FAIL_THRESH=5
SOC_UA_ROTATION_THRESH=3
SOC_ENABLE_MONGO_PROFILING=false

# Azure NSG blocking (required when BLOCK_LAYER_AZURE=true)
# AZURE_SUBSCRIPTION_ID=
# AZURE_RESOURCE_GROUP=
# AZURE_NSG_NAME=
# AZURE_CLIENT_ID=
# AZURE_TENANT_ID=
# AZURE_CLIENT_SECRET=

# Nginx config (required when BLOCK_LAYER_NGINX=true)
# NGINX_BLOCKLIST_PATH=/etc/nginx/conf.d/blocklist.conf
# NGINX_RELOAD_CMD=nginx -s reload
