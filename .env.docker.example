# ── App ────────────────────────────────────────────────────────────────────────
DEBUG=false
FRONTEND_URL=http://localhost:8000

# ── MongoDB ────────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://sentinelai-mongo:27017
MONGODB_DB=sentinelai

# ── JWT ────────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=CHANGE_ME_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Email — Brevo (optional but recommended) ─────────────────────────────────
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=SentinelAI

# ── AI — Groq ──────────────────────────────────────────────────────────────────
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_MODEL=llama-3.1-8b-instant

# ── Agent 02 — Neo4j / Weaviate (optional depending on usage) ───────────────
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
WEAVIATE_URL=
WEAVIATE_KEY=

# ── Agent 02 — Models ─────────────────────────────────────────────────────────
REASONING_MODEL=llama-3.1-8b-instant
ROUTING_MODEL=llama-3.1-8b-instant
EMBEDDING_MODEL=
EMBEDDING_DIM=3072

# ── Agent 02 — Data sources & schedule ───────────────────────────────────────
GDELT_API_URL=https://api.gdeltproject.org/api/v2
PATTERN_SCAN_INTERVAL_HOURS=1
INGESTION_INTERVAL_MINUTES=15

# ── Security ───────────────────────────────────────────────────────────────────
COOKIE_SECURE=false
RECAPTCHA_SECRET_KEY=
TURNSTILE_SECRET_KEY=

# Comma-separated allowed origins
CORS_ORIGINS=http://localhost:8000

# ── Vault (optional) ───────────────────────────────────────────────────────────
VAULT_ENABLED=false
VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=
VAULT_NAMESPACE=
VAULT_MOUNT=secret
VAULT_SECRET_PATH=sentinelai/llm
VAULT_GEMINI_KEY_FIELD=google_api_key
VAULT_REFRESH_INTERVAL_SECONDS=60
VAULT_TIMEOUT_SECONDS=5
